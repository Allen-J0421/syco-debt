# Local, machine-specific paths. Copy to .env and adjust as needed.
# .env is intentionally ignored by Git.

# SWE-Refactor dataset
RDP_DATASET=/Users/allenjiang/Documents/workspace/SWE-Refactor/pure_refactoring_data.json

# Runtime data: repo mirrors, worktrees, metric tools, and run artifacts.
RDP_HOME=/Users/allenjiang/rdp

# JDKs used by `measure` and `verify`.
RDP_JDK8_HOME=/opt/homebrew/opt/openjdk@8/libexec/openjdk.jdk/Contents/Home
RDP_JDK11_HOME=/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home
RDP_JDK17_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home
RDP_JDK21_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home

# Required when running the simulated developer.
# GEMINI_API_KEY=...
